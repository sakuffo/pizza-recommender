# Use official Nginx image as base
FROM nginx:stable-alpine AS final

# Remove default nginx configuration
RUN rm /etc/nginx/conf.d/default.conf

# Copy the Docker-specific Nginx configuration
COPY docker/nginx-docker.conf /etc/nginx/conf.d/default.conf 

# Copy static assets (CSS, JS) from context's app/static/
COPY --link app/static /usr/share/nginx/html/static

# Copy HTML file from context's app/static/index.html
COPY --link app/static/index.html /usr/share/nginx/html/index.html

# Expose port 80 (standard HTTP)
EXPOSE 80

# Start Nginx in the foreground
CMD ["nginx", "-g", "daemon off;"] 