server {
    listen 80;
    server_name {{ ansible_fqdn | default(inventory_hostname) }}; # Use Ansible facts for server_name

    # Root directory for frontend files deployed by Ansible
    root /var/www/pizza-app;

    # Serve index.html as the default file
    index index.html;

    # API Reverse Proxy: Forward requests starting with /api/ to the backend service
    location /api/ {
        # Remove /api/ prefix before forwarding
        rewrite ^/api/(.*)$ /$1 break;
        
        # Proxy to the backend service IP defined in Ansible inventory
        proxy_pass http://{{ backend_ip_address }}:8080; # Use template variable
        
        # Standard proxy headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Serve static files directly
    location /static/ {
        try_files $uri $uri/ =404;
    }

    # Handle requests to the root or any path not matching /static/ or /api/
    location / {
        try_files $uri /index.html;
    }

    # Optional: Add headers for security, caching, etc.
    # add_header Cache-Control "public, max-age=3600";
    # add_header X-Frame-Options "SAMEORIGIN";
    # add_header X-Content-Type-Options "nosniff";
    # add_header X-XSS-Protection "1; mode=block";
} 