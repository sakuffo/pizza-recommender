# VM Deployment Environment Configuration
# Copy this file to .env.vm and update with your actual values
# Used when deploying to separate VMs

# Database connection settings
# Point this to your PostgreSQL VM's IP or hostname
DB_HOST=192.168.1.10
DB_PORT=5432
DB_USER=pizza
DB_PASSWORD=your_secure_password_here
DB_NAME=pizza
DB_SSLMODE=require

# Backend API settings
API_HOST=0.0.0.0
API_PORT=8080
